# ARK Pi6X Flow carrier + Raspberry Pi Compute Module 4.  [STUB — untested on hardware]
#
# The config below is transcribed from the Pi6X Flow flashing guide but has never been
# validated on a board, so it's gated off. Remove the TARGET_STUB line to build it.
#   docs.arkelectron.com/products/flight-controller/ark-pi6x-flow/flashing-guide/after-flashing-before-installing
#
# The Pi6X Flow has an onboard ARKV6X flight controller wired to the Pi over UART
# (uart3/uart4, hardware CTS/RTS) and USB, plus two CSI ports and a cooling-fan header.

TARGET_STUB=1
TARGET_DESC="ARK Pi6X Flow (onboard ARKV6X) + CM4  [untested]"
TARGET_HOSTNAME="pi6x"

CONFIG_TXT_DISABLE=(
    "camera_auto_detect=1"
    "display_auto_detect=1"
)

CONFIG_TXT_APPEND=$(cat <<'EOF'
# UART links to the onboard ARKV6X, with hardware flow control
enable_uart=1
dtoverlay=uart3,ctsrts
dtoverlay=uart4,ctsrts
# Carrier GPIO line initial states (per ARK hardware docs)
gpio=25=op,dl
gpio=27=op,dh
gpio=26=op,dh
# CSI cameras (IMX219 modules)
dtoverlay=imx219,cam0
dtoverlay=imx219,cam1
# Cooling fan
dtoverlay=gpio-fan,gpiopin=19
EOF
)
