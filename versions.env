# Pinned inputs for the ARK-OS Raspberry Pi golden image: the OS release to base on,
# the ARK-OS payload, appliance defaults, and which hardware target to build. Keep
# MAVSDK_VERSION in sync with ARK-OS packaging/versions.env.

# --- Stock base image -------------------------------------------------------
# Raspberry Pi OS Lite, arm64 — pinned to a dated Bookworm (Debian 12) release so the
# golden image is reproducible and matches the ark-os-pi deb's Debian 12 ABI (its
# Depends target Bookworm's python3/library versions; MAVSDK ships as debian12_arm64).
#
# Do NOT switch to the _latest redirect: it now resolves to Trixie (Debian 13), whose
# python3/library versions don't match the Bookworm-built deb. When ARK-OS ships a
# Trixie deb, bump these lines to the newest Trixie release and its sha256 (taken from
# the published <image>.img.xz.sha256 sidecar) and set PIOS_RELEASE="trixie". setup.sh
# verifies the download. config.txt stays at /boot/firmware/config.txt for both.
PIOS_RELEASE="bookworm"
PIOS_IMAGE_URL="https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2025-05-13/2025-05-13-raspios-bookworm-arm64-lite.img.xz"
PIOS_IMAGE_SHA256="62d025b9bc7ca0e1facfec74ae56ac13978b6745c58177f081d39fbb8041ed45"

# --- ARK-OS payload ---------------------------------------------------------
# The ark-os-pi deb and its hard dependency MAVSDK (no apt repo). A 0.0.0-<sha8>
# value matches an untagged CI artifact; drop that deb into downloads/ and the
# build will use it. Switch to a released version once ARK-OS PR #68 is tagged.
ARK_OS_VERSION="0.0.0-4e1fc680"
MAVSDK_VERSION="3.17.1"

# --- Build target -----------------------------------------------------------
# Carrier board × compute module. Selects targets/<TARGET>.target, which supplies the
# image's hostname and the carrier-specific config.txt overlays. Build another with
# `./build.sh <target>` or `TARGET=<target> ./build.sh`.
# Available: pi6x-cm4 (default), pi6x-cm5, justapi-cm4, justapi-cm5 — see targets/.
TARGET="${TARGET:-pi6x-cm4}"

# --- Baked appliance account ------------------------------------------------
# The ark-os-pi deb runs every service as User=pi, and Bookworm ships NO default
# user, so the image MUST bake one. This is an appliance default — document that
# operators change it (or wire in Pi OS userconf) before shipping real units.
ARK_PI_USER="pi"
ARK_PI_PASSWORD="raspberry"

# Enable the SSH server in the image so the headless appliance is reachable on first
# boot. (The flashing guide otherwise has users drop an `ssh` file in the boot
# partition by hand.) Set to 0 to leave SSH disabled.
ENABLE_SSH="1"

# --- Image sizing -----------------------------------------------------------
# Megabytes to grow the stock image's root partition before installing, so the
# venv + node + gstreamer payload fits. Pi OS re-expands root to fill the card on
# first boot regardless; this is only about provisioning headroom.
GROW_MB="3072"
