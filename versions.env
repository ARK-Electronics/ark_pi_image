# Pinned inputs for the ARK-OS Raspberry Pi golden image: the OS release to base on,
# the ARK-OS payload, appliance defaults, and which hardware target to build. Keep
# MAVSDK_VERSION in sync with ARK-OS packaging/versions.env.
#
# This repo tracks ONE Pi OS release at a time. It is currently Trixie (Debian 13);
# Bookworm is no longer supported. For an older OS, check out an older tag/branch.

# --- Stock base image -------------------------------------------------------
# Raspberry Pi OS Lite, arm64 — pinned to a dated Trixie (Debian 13) release so the
# golden image is reproducible and matches the ark-os-pi-trixie deb (built for Debian 13).
# To move to a newer release, bump these three lines together: URL + sha256 (from the
# published <image>.img.xz.sha256 sidecar) + PIOS_RELEASE, and rebuild the ARK-OS deb for
# that release. setup.sh verifies the download (and re-fetches a stale cache). config.txt
# stays at /boot/firmware/config.txt.
PIOS_RELEASE="trixie"
PIOS_IMAGE_URL="https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-04-21/2026-04-21-raspios-trixie-arm64-lite.img.xz"
PIOS_IMAGE_SHA256="4cd31df026fd82243805a326dc0cafd7383f7e3d30c9413e7044d507aae281e2"

# --- ARK-OS payload ---------------------------------------------------------
# The ARK-OS deb + its hard dependency MAVSDK (no apt repo). The deb name tracks
# PIOS_RELEASE (ark-os-pi-<codename>), so it resolves to ark-os-pi-trixie — built by
# ARK-OS's trixie CI leg against Debian 13 / python3.13, matching this base image. (The
# deb's preinst refuses to install if its codename != the host's, so the two MUST agree.)
# A 0.0.0-<sha8> version matches an untagged CI artifact; drop that deb into downloads/
# and the build uses it.
#
# MAVSDK stays the debian12_arm64 build (MAVSDK ships no debian13 arm64 asset). It's C++
# and libstdc++ is backward compatible, so the Bookworm build runs fine on Trixie.
#
# NOTE: 0.0.0-0af28d74 was the Bookworm artifact's sha — update it to the sha8 of the
# ark-os-pi-trixie artifact (the commit that adds ARK-OS's trixie build).
ARK_OS_VERSION="0.0.0-0af28d74"
MAVSDK_VERSION="3.17.1"

# --- Build target -----------------------------------------------------------
# Carrier board × compute module. Selects targets/<TARGET>.target, which supplies the
# image's hostname and the carrier-specific config.txt overlays. Build another with
# `./build.sh <target>` or `TARGET=<target> ./build.sh`.
#
# Available: pi6x-cm4 (default), pi6x-cm5, justapi-cm4, justapi-cm5 — see targets/.
# Pi6X is native on CM4 and Just-A-Pi on CM5; the cross combos (pi6x-cm5, justapi-cm4)
# have hardware caveats — see the README.
TARGET="${TARGET:-pi6x-cm4}"

# --- Baked appliance account ------------------------------------------------
# The ark-os-pi-trixie deb runs every service as User=pi, and Pi OS Lite ships NO
# default user, so the image MUST bake one. This is an appliance default — document
# that operators change it (or wire in Pi OS userconf) before shipping real units.
ARK_PI_USER="pi"
ARK_PI_PASSWORD="raspberry"

# Enable the SSH server in the image so the headless appliance is reachable on first
# boot. (The flashing guide otherwise has users drop an `ssh` file in the boot
# partition by hand.) Set to 0 to leave SSH disabled.
ENABLE_SSH="1"

# --- Image sizing -----------------------------------------------------------
# Megabytes to grow the stock image's root partition before installing, so the
# venv + node + gstreamer payload fits. Pi OS re-expands root to fill the card on
# first boot regardless; this is only about provisioning headroom.
GROW_MB="3072"
