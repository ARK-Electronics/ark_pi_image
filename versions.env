# Pinned inputs for the golden image. Tracks ONE Pi OS release at a time (currently
# Trixie); for Bookworm, check out an older tag.

# --- Base image -------------------------------------------------------------
# Raspberry Pi OS Lite arm64, pinned for reproducibility. To move releases, bump all
# three together (sha256 from the published .img.xz.sha256 sidecar) and rebuild the
# ARK-OS deb to match. setup.sh verifies the download and re-fetches a stale cache.
PIOS_RELEASE="trixie"
PIOS_IMAGE_URL="https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-04-21/2026-04-21-raspios-trixie-arm64-lite.img.xz"
PIOS_IMAGE_SHA256="4cd31df026fd82243805a326dc0cafd7383f7e3d30c9413e7044d507aae281e2"

# --- ARK-OS payload (installed only with --provision) -----------------------
# The deb name tracks PIOS_RELEASE → ark-os-pi-trixie; its preinst refuses to install
# if the codename != the host's, so base and deb MUST agree.
#   ARK_OS_VERSION set (e.g. "1.0.0"): provision.sh downloads that GitHub release asset.
#   empty: dev mode — install the newest ark-os-pi-trixie_*_arm64.deb in downloads/
#          (for CI artifacts, which are versioned 0.0.0-<sha8> and never released).
# MAVSDK needs no pin here: it is bundled inside the ark-os deb since ARK-OS#75.
ARK_OS_VERSION="1.0.8"

# --- Robotics payload (installed only with --robotics / --hailo) ------------
# Opt-in extras for robotics work, all OFF unless build.sh is given the flags:
#   --robotics : ROS 2 + OpenCV   (ROS2_* and OPENCV_PACKAGES below)
#   --hailo    : Hailo AI accelerator stack (HAILO_PACKAGE) + carrier PCIe Gen 3
# Both layer on top of the stock/ark-os image and can be combined.
#
# ROS 2 has NO official Debian/Trixie packages — Debian is a Tier-3 platform and
# upstream recommends Docker. These pull the community-built *native* Trixie debs
# from the rospian apt repo (https://github.com/rospian/rospian-repo); the apt
# source is left in the image so more ros-jazzy-* packages can be added on device.
# Default is ros-base (headless) since the base image is Pi OS Lite — switch to
# desktop / desktop-full / perception if you want rviz/gazebo and have a display.
ROS2_DISTRO="jazzy"
ROS2_PACKAGE="ros-jazzy-ros-base"
ROS2_DEV_TOOLS="python3-colcon-common-extensions python3-rosdep python3-vcstool"
ROS2_APT_REPO="https://rospian.github.io/rospian-repo"
ROS2_APT_SUITE="trixie-jazzy"
ROS2_APT_KEY_URL="https://rospian.github.io/rospian-repo/rospian-archive-keyring.asc"

# OpenCV from Debian (python3 bindings + dev headers + GStreamer plugins for camera
# pipelines). Trixie ships OpenCV 4.x; no third-party repo needed.
OPENCV_PACKAGES="python3-opencv libopencv-dev"

# Hailo: Raspberry Pi's hailo-all metapackage (hailort runtime + firmware + the
# rpicam/TAPPAS integration). The hailo_pci PCIe driver is in the Pi kernel, so no
# DKMS build is needed — this is userspace only and installs cleanly in the chroot.
# Comes from the Raspberry Pi apt repo already configured in the base image.
HAILO_PACKAGE="hailo-all"

# --- Build target -----------------------------------------------------------
# Carrier × compute module → targets/<TARGET>.target (hostname + config.txt overlays).
# justapi-cm5 (default) is supported; pi6x-cm4 is an untested stub. See targets/.
TARGET="${TARGET:-justapi-cm5}"

# --- Baked appliance account ------------------------------------------------
# Every ark-os service runs as User=pi. Pi OS ships a locked 'pi' placeholder;
# configure_target.sh sets this password on it and writes userconf.txt so the first-boot
# wizard doesn't block SSH. Appliance default — change it before shipping real units.
ARK_PI_USER="pi"
ARK_PI_PASSWORD="pi"
ENABLE_SSH="1"

# MiB to grow root before installing, so the venv + node + gstreamer payload fits. Pi OS
# re-expands root to fill the card on first boot; this is just provisioning headroom.
GROW_MB="3072"
