# NetworkManager profile for the USB gadget link (usb0). method=shared gives the Pi
# 192.168.55.1/24 (the Jetson-style address ARK users already know), serves the host a
# DHCP lease via NM's dnsmasq, and NATs to the Pi's uplink if one exists. mDNS still
# works over the link, so `ssh pi@<hostname>.local` also resolves. Installed 0600
# root:root or NetworkManager refuses to load it.
[connection]
id=ark-usb-gadget
uuid=b9f5905a-2b1f-4ec6-8f3c-3a1bb27dd821
type=ethernet
interface-name=usb0
autoconnect=true
autoconnect-priority=100

[ipv4]
method=shared
address1=192.168.55.1/24

[ipv6]
method=link-local
